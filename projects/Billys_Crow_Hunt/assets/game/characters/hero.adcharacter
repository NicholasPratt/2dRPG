ADCHARACTER 1
name "Hero"
bio "A new character. Use this sheet for story notes, personality, and role."
sprite "assets/game/sprites/hero.sprite.json"
playable 1
animations 27
anim "idle" "assets/game/sprites/hero.sprite.json"
anim "walk" "assets/game/sprites/hero.sprite.json"
anim "run" "assets/game/sprites/hero.sprite.json"
anim "attack_1" "assets/game/sprites/hero.sprite.json"
anim "attack_2" "assets/game/sprites/hero.sprite.json"
anim "attack_3" "assets/game/sprites/hero.sprite.json"
anim "cast" "assets/game/sprites/hero.sprite.json"
anim "hit_react" "assets/game/sprites/hero.sprite.json"
anim "guard" "assets/game/sprites/hero.sprite.json"
anim "interact" "assets/game/sprites/hero.sprite.json"
anim "conversation" "assets/game/sprites/hero.sprite.json"
anim "death" "assets/game/sprites/hero.sprite.json"
anim "fall" "assets/game/sprites/hero.sprite.json"
anim "sleep" "assets/game/sprites/hero.sprite.json"
anim "jump" "assets/game/sprites/hero.sprite.json"
anim "land" "assets/game/sprites/hero.sprite.json"
anim "pickup" "assets/game/sprites/hero.sprite.json"
anim "use_item" "assets/game/sprites/hero.sprite.json"
anim "hurt_loop" "assets/game/sprites/hero.sprite.json"
