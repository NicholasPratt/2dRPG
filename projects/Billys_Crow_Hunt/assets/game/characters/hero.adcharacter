anim "victory" "assets/game/sprites/hero.sprite.json"
anim "emote" "assets/game/sprites/hero.sprite.json"
anim "climb" "assets/game/sprites/hero.sprite.json"
anim "swim" "assets/game/sprites/hero.sprite.json"
anim "dash" "assets/game/sprites/hero.sprite.json"
anim "block_break" "assets/game/sprites/hero.sprite.json"
anim "revive" "assets/game/sprites/hero.sprite.json"
frames 2
frame 0 "idle" "assets/raw/sprites/hero_frame_1.png"
frame 1 "idle" "assets/raw/sprites/hero_frame_2.png"
end
